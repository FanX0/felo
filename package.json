{
  "name": "felo",
  "version": "1.1.0-beta.1",
  "description": "Felo desktop music player and library workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/FanX0/felo.git"
  },
  "main": "./out/main/index.js",
  "author": "Felo",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/dev.mjs",
    "dev:public": "node scripts/dev.mjs --public",
    "dev:private": "node scripts/dev.mjs --private",
    "clean:electron": "node scripts/dev.mjs --clean-only",
    "build": "npm run typecheck && electron-vite build",
    "build:providers": "node scripts/compile-providers.mjs",
    "build:public": "node scripts/build-app.mjs --public",
    "build:private": "node scripts/build-app.mjs --private",
    "build:app:public": "node scripts/build-app.mjs --public",
    "build:app:private": "node scripts/build-app.mjs --private",
    "build:app:all": "node scripts/build-app.mjs --all",
    "build:win": "npm run build && electron-builder --win",
    "build:win:public": "node scripts/build-app.mjs --public --win",
    "build:win:private": "node scripts/build-app.mjs --private --win",
    "build:win:all": "node scripts/build-app.mjs --all --win",
    "build:web": "npm run typecheck:web && electron-vite build",
    "universal-bot": "node scripts/universal-discord-bot.mjs",
    "bot:autostart": "node scripts/setup-autostart.mjs",
    "bot:autostart:remove": "node scripts/setup-autostart.mjs --remove",
    "bot:pm2": "npx pm2 start scripts/universal-discord-bot.mjs --name felo-discord-bot",
    "register:discord": "node scripts/register-discord-commands.mjs",
    "postinstall": "node -e \"try { require('child_process').execSync('electron-builder install-app-deps', { stdio: 'inherit' }) } catch (_) {}\"",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "setup:music-presence": "node scripts/setup-felo-music-presence.js",
    "mobile:build": "npm run build",
    "mobile:sync": "npx cap sync",
    "mobile:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "sync:private": "node scripts/repo-sync.mjs private",
    "sync:public": "node scripts/repo-sync.mjs public",
    "sync:status": "node scripts/repo-sync.mjs status",
    "deploy:cf": "npm run build:web && npx wrangler pages deploy out/renderer --project-name=felo",
    "deploy:cf:preview": "npm run build:web && npx wrangler pages deploy out/renderer --project-name=felo --branch=preview",
    "deploy:worker": "npm run build:web && npx wrangler deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lit/react": "^1.0.8",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@uimaxbai/am-lyrics": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "egoroof-blowfish": "^4.0.3",
    "lit": "^3.3.3",
    "lucide-react": "^1.33.0",
    "music-metadata": "^11.15.0",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.2",
    "slsk-client": "^1.1.0",
    "soulseek-ts": "^2.1.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "pg": "^8.23.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
